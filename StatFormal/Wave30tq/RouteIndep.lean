import StatFormal.Wave30tq.Statements
import StatFormal.Lib.Betting.Wealth
import Mathlib.MeasureTheory.Integral.Pi
import Mathlib.MeasureTheory.Integral.Prod
import StatFormal.Lib.Distances.TV

/-!
# Wave 30tq route: independence of the fold-two coordinates and of the block statistics (untrusted)

On `𝒳^n × 𝒳^m` under `P^{⊗n} ⊗ Q^{⊗m}` the `n + m` coordinates (indexed by `Fin n ⊕ Fin m`) are mutually
independent (`iIndepFun_coord`, via `MeasurableEquiv.sumPiEquivProdPi`); a function of the coordinates in a set `C`
is measurable for `σ(coordinates in C)`, and blocks with disjoint coordinate sets are independent.
-/

noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped ENNReal

namespace StatFormal.Wave30tq

variable {𝒳 : Type*} [MeasurableSpace 𝒳] {n m : ℕ}

/-- The coordinate `j` of the fold-two sample `ω = (x, y)`: `x_i` for `j = inl i`, `y_i` for `j = inr i`. -/
def coord (j : Fin n ⊕ Fin m) (ω : (Fin n → 𝒳) × (Fin m → 𝒳)) : 𝒳 := Sum.elim ω.1 ω.2 j

lemma measurable_coord (j : Fin n ⊕ Fin m) : Measurable (coord (𝒳 := 𝒳) j) := by
  cases j with
  | inl i => exact (measurable_pi_apply i).comp measurable_fst
  | inr i => exact (measurable_pi_apply i).comp measurable_snd

/-- The fold-two coordinates are mutually independent. -/
lemma iIndepFun_coord (P Q : Measure 𝒳) [IsProbabilityMeasure P] [IsProbabilityMeasure Q] :
    iIndepFun (fun j : Fin n ⊕ Fin m => coord (𝒳 := 𝒳) j)
      ((Measure.pi fun _ : Fin n => P).prod (Measure.pi fun _ : Fin m => Q)) := by
  set μs : Fin n ⊕ Fin m → Measure 𝒳 := Sum.elim (fun _ => P) (fun _ => Q) with hμs
  have : ∀ j, IsProbabilityMeasure (μs j) := fun j => by
    cases j with
    | inl i => simp only [hμs, Sum.elim_inl]; infer_instance
    | inr i => simp only [hμs, Sum.elim_inr]; infer_instance
  have hmp := measurePreserving_sumPiEquivProdPi_symm (X := fun _ : Fin n ⊕ Fin m => 𝒳) μs
  have hν : ((Measure.pi fun i => μs (.inl i)).prod (Measure.pi fun i => μs (.inr i))) =
      ((Measure.pi fun _ : Fin n => P).prod (Measure.pi fun _ : Fin m => Q)) := rfl
  rw [hν] at hmp
  rw [iIndepFun_iff_map_fun_eq_pi_map (fun j => (measurable_coord j).aemeasurable)]
  have h1 : (fun ω (j : Fin n ⊕ Fin m) => coord (𝒳 := 𝒳) j ω) =
      (MeasurableEquiv.sumPiEquivProdPi fun _ : Fin n ⊕ Fin m => 𝒳).symm := by
    funext ω j; cases j <;> rfl
  rw [h1, hmp.map_eq]
  congr 1
  funext j
  have h2 : coord (𝒳 := 𝒳) j = (fun x : Fin n ⊕ Fin m → 𝒳 => x j) ∘
      (MeasurableEquiv.sumPiEquivProdPi fun _ : Fin n ⊕ Fin m => 𝒳).symm := by
    funext ω; cases j <;> rfl
  rw [h2, ← Measure.map_map (measurable_pi_apply j) (MeasurableEquiv.measurable _), hmp.map_eq,
    (measurePreserving_eval μs j).map_eq]


/-- The σ-algebra generated by the coordinates in `C`. -/
@[instance_reducible] def coordSigma (C : Set (Fin n ⊕ Fin m)) : MeasurableSpace ((Fin n → 𝒳) × (Fin m → 𝒳)) :=
  ⨆ j ∈ C, MeasurableSpace.comap (coord (𝒳 := 𝒳) j) inferInstance

lemma coordSigma_le (C : Set (Fin n ⊕ Fin m)) :
    coordSigma (𝒳 := 𝒳) C ≤ (inferInstance : MeasurableSpace ((Fin n → 𝒳) × (Fin m → 𝒳))) :=
  iSup₂_le fun j _ => (measurable_coord j).comap_le

lemma coordSigma_mono {C D : Set (Fin n ⊕ Fin m)} (h : C ⊆ D) :
    coordSigma (𝒳 := 𝒳) C ≤ coordSigma D :=
  biSup_mono fun _ hj => h hj

lemma measurable_coord_sigma {C : Set (Fin n ⊕ Fin m)} {j : Fin n ⊕ Fin m} (hj : j ∈ C) :
    Measurable[coordSigma C] (coord (𝒳 := 𝒳) j) :=
  measurable_iff_comap_le.2
    (le_iSup₂ (f := fun j (_ : j ∈ C) => MeasurableSpace.comap (coord (𝒳 := 𝒳) j) inferInstance) j hj)

variable {N : ℕ}

/-- The coordinates used by block `k`: `inl '' A_k ∪ inr '' B_k`. -/
def blockSet (A : Fin N → Finset (Fin n)) (B : Fin N → Finset (Fin m)) (k : Fin N) :
    Set (Fin n ⊕ Fin m) :=
  Sum.inl '' (A k : Set (Fin n)) ∪ Sum.inr '' (B k : Set (Fin m))

lemma measurable_pairZ_sigma {g : 𝒳 → ℝ} (hg : Measurable g) (A : Fin N → Finset (Fin n))
    (B : Fin N → Finset (Fin m)) (k : Fin N) :
    Measurable[coordSigma (blockSet A B k)] (fun ω : (Fin n → 𝒳) × (Fin m → 𝒳) => pairZ g A B ω.1 ω.2 k) := by
  unfold pairZ blockMean
  refine Measurable.sub ?_ ?_
  · refine Measurable.div_const (Finset.measurable_sum _ fun i hi => ?_) _
    have : (fun ω : (Fin n → 𝒳) × (Fin m → 𝒳) => g (ω.1 i)) = g ∘ coord (Sum.inl i) := rfl
    rw [this]
    exact hg.comp (measurable_coord_sigma (Or.inl ⟨i, by exact_mod_cast hi, rfl⟩))
  · refine Measurable.div_const (Finset.measurable_sum _ fun j hj => ?_) _
    have : (fun ω : (Fin n → 𝒳) × (Fin m → 𝒳) => g (ω.2 j)) = g ∘ coord (Sum.inr j) := rfl
    rw [this]
    exact hg.comp (measurable_coord_sigma (Or.inr ⟨j, by exact_mod_cast hj, rfl⟩))

lemma measurable_pairZ {g : 𝒳 → ℝ} (hg : Measurable g) (A : Fin N → Finset (Fin n))
    (B : Fin N → Finset (Fin m)) (k : Fin N) :
    Measurable (fun ω : (Fin n → 𝒳) × (Fin m → 𝒳) => pairZ g A B ω.1 ω.2 k) :=
  (measurable_pairZ_sigma hg A B k).mono (coordSigma_le _) le_rfl

lemma blockSet_disjoint {A : Fin N → Finset (Fin n)} {B : Fin N → Finset (Fin m)}
    (hAB : IsBlockPairing A B) {k l : Fin N} (hkl : k ≠ l) :
    Disjoint (blockSet A B k) (blockSet A B l) := by
  obtain ⟨-, -, hA, hB⟩ := hAB
  rw [Set.disjoint_left]
  rintro j (⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩) (⟨i', hi', hii'⟩ | ⟨i', hi', hii'⟩)
  · cases Sum.inl.inj hii'
    exact Finset.disjoint_left.1 (hA k l hkl) (by exact_mod_cast hi) (by exact_mod_cast hi')
  · cases hii'
  · cases hii'
  · cases Sum.inr.inj hii'
    exact Finset.disjoint_left.1 (hB k l hkl) (by exact_mod_cast hi) (by exact_mod_cast hi')

/-- Each block statistic is independent of the earlier ones. -/
lemma indep_pairZ_past (P Q : Measure 𝒳) [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    {g : 𝒳 → ℝ} (hg : Measurable g) {A : Fin N → Finset (Fin n)} {B : Fin N → Finset (Fin m)}
    (hAB : IsBlockPairing A B) (k : Fin N) :
    Indep (MeasurableSpace.comap (fun ω : (Fin n → 𝒳) × (Fin m → 𝒳) => pairZ g A B ω.1 ω.2 k) inferInstance)
      (⨆ i ∈ {i : Fin N | (i : ℕ) < k},
        MeasurableSpace.comap (fun ω : (Fin n → 𝒳) × (Fin m → 𝒳) => pairZ g A B ω.1 ω.2 i) inferInstance)
      ((Measure.pi fun _ : Fin n => P).prod (Measure.pi fun _ : Fin m => Q)) := by
  have hI := (iIndepFun_iff_iIndep _ _ _).1 (iIndepFun_coord (n := n) (m := m) P Q)
  set U : Set (Fin n ⊕ Fin m) := ⋃ i ∈ {i : Fin N | (i : ℕ) < k}, blockSet A B i with hU
  have hdisj : Disjoint (blockSet A B k) U := by
    rw [hU, Set.disjoint_iUnion₂_right]
    intro i hi
    exact blockSet_disjoint hAB (fun h => (lt_irrefl (k : ℕ)) (h ▸ hi))
  have H := indep_iSup_of_disjoint (fun j => (measurable_coord (𝒳 := 𝒳) j).comap_le) hI hdisj
  refine indep_of_indep_of_le_right (indep_of_indep_of_le_left H ?_) ?_
  · exact (measurable_pairZ_sigma hg A B k).comap_le
  · refine iSup₂_le fun i hi => ?_
    exact (measurable_pairZ_sigma hg A B i).comap_le.trans
      (coordSigma_mono (Set.subset_biUnion_of_mem (u := fun i => blockSet A B i) hi))

lemma blockMean_mem {n : ℕ} {A : Finset (Fin n)} (hA : A.Nonempty) {u : Fin n → ℝ}
    (hu : ∀ i, u i ∈ Icc (0 : ℝ) 1) : blockMean A u ∈ Icc (0 : ℝ) 1 := by
  unfold blockMean
  have hc : (0 : ℝ) < A.card := by exact_mod_cast hA.card_pos
  refine ⟨div_nonneg (Finset.sum_nonneg fun i _ => (hu i).1) hc.le, ?_⟩
  rw [div_le_one hc]
  calc ∑ i ∈ A, u i ≤ ∑ _i ∈ A, (1 : ℝ) := Finset.sum_le_sum fun i _ => (hu i).2
    _ = A.card := by simp

omit [MeasurableSpace 𝒳] in
lemma pairZ_mem {g : 𝒳 → ℝ} (hg01 : ∀ x, g x ∈ Icc (0 : ℝ) 1) {A : Fin N → Finset (Fin n)}
    {B : Fin N → Finset (Fin m)} (hAB : IsBlockPairing A B) (k : Fin N) (x : Fin n → 𝒳)
    (y : Fin m → 𝒳) : pairZ g A B x y k ∈ Icc (-1 : ℝ) 1 := by
  have h1 := blockMean_mem (hAB.1 k) (u := fun i => g (x i)) fun i => hg01 _
  have h2 := blockMean_mem (hAB.2.1 k) (u := fun j => g (y j)) fun j => hg01 _
  unfold pairZ
  constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]

lemma integral_pairZ (P Q : Measure 𝒳) [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    {g : 𝒳 → ℝ} (hg : Measurable g) (hg01 : ∀ x, g x ∈ Icc (0 : ℝ) 1)
    {A : Fin N → Finset (Fin n)} {B : Fin N → Finset (Fin m)} (hAB : IsBlockPairing A B) (k : Fin N) :
    ∫ ω, pairZ g A B ω.1 ω.2 k ∂((Measure.pi fun _ : Fin n => P).prod (Measure.pi fun _ : Fin m => Q)) =
      (∫ x, g x ∂P) - ∫ y, g y ∂Q := by
  have hgi : ∀ μ : Measure 𝒳, IsFiniteMeasure μ → Integrable g μ := fun μ _ =>
    Integrable.of_mem_Icc 0 1 hg.aemeasurable (ae_of_all _ hg01)
  set ν := (Measure.pi fun _ : Fin n => P).prod (Measure.pi fun _ : Fin m => Q)
  have hx : ∀ i : Fin n, ∫ ω, g (ω.1 i) ∂ν = ∫ x, g x ∂P := fun i => by
    rw [integral_fun_fst (fun x : Fin n → 𝒳 => g (x i)), probReal_univ, one_smul]
    exact integral_comp_eval (μ := fun _ : Fin n => P) (i := i) (hgi P inferInstance).aestronglyMeasurable
  have hy : ∀ j : Fin m, ∫ ω, g (ω.2 j) ∂ν = ∫ y, g y ∂Q := fun j => by
    rw [integral_fun_snd (fun y : Fin m → 𝒳 => g (y j)), probReal_univ, one_smul]
    exact integral_comp_eval (μ := fun _ : Fin m => Q) (i := j) (hgi Q inferInstance).aestronglyMeasurable
  have hix : ∀ i : Fin n, Integrable (fun ω : (Fin n → 𝒳) × (Fin m → 𝒳) => g (ω.1 i)) ν := fun i =>
    Integrable.of_mem_Icc 0 1 (hg.comp ((measurable_pi_apply i).comp measurable_fst)).aemeasurable
      (ae_of_all _ fun ω => hg01 _)
  have hiy : ∀ j : Fin m, Integrable (fun ω : (Fin n → 𝒳) × (Fin m → 𝒳) => g (ω.2 j)) ν := fun j =>
    Integrable.of_mem_Icc 0 1 (hg.comp ((measurable_pi_apply j).comp measurable_snd)).aemeasurable
      (ae_of_all _ fun ω => hg01 _)
  have hcA : ((A k).card : ℝ) ≠ 0 := by exact_mod_cast (hAB.1 k).card_pos.ne'
  have hcB : ((B k).card : ℝ) ≠ 0 := by exact_mod_cast (hAB.2.1 k).card_pos.ne'
  unfold pairZ blockMean
  rw [integral_sub ((integrable_finsetSum _ fun i _ => hix i).div_const _)
    ((integrable_finsetSum _ fun j _ => hiy j).div_const _), integral_div, integral_div,
    integral_finsetSum _ fun i _ => hix i, integral_finsetSum _ fun j _ => hiy j]
  simp_rw [hx, hy]
  simp only [Finset.sum_const, nsmul_eq_mul]
  field_simp

/-- `E_P g − E_Q g ≤ TV(P,Q)` for a measurable `[0,1]`-valued `g`. -/
lemma delta_le_tv (P Q : Measure 𝒳) [IsProbabilityMeasure P] [IsProbabilityMeasure Q] {g : 𝒳 → ℝ}
    (hg : Measurable g) (hg01 : ∀ x, g x ∈ Icc (0 : ℝ) 1) :
    (∫ x, g x ∂P) - (∫ y, g y ∂Q) ≤ StatFormal.Distances.tvDist P Q := by
  have := StatFormal.Distances.integral_sub_le_mul_tvDist_of_nonneg (μ := P) (ν := Q) hg zero_le_one
    (fun x => (hg01 x).1) (fun x => (hg01 x).2)
  simpa using this

/-- §2.3: the pair statistics are in `[−1,1]`, have mean `Δ`, are independent, and `Δ ≤ TV`. -/
theorem pair_facts_route : Claims.pair_facts := by
  intro 𝒳 _ P Q _ _ n m N A B g hAB hg hg01
  refine ⟨fun k x y => pairZ_mem hg01 hAB k x y, fun k => integral_pairZ P Q hg hg01 hAB k, ?_,
    delta_le_tv P Q hg hg01⟩
  refine StatFormal.Betting.iIndepFun_of_indep_past _ (fun k => measurable_pairZ hg A B k) fun k => ?_
  have hset : {i : Fin N | i < k} = {i : Fin N | (i : ℕ) < k} := by
    ext i; exact Fin.lt_def
  rw [hset]
  exact indep_pairZ_past P Q hg hAB k

end StatFormal.Wave30tq
