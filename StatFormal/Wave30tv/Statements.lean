set_option linter.style.longLine false

noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped ENNReal

namespace StatFormal.Wave30tv

open StatFormal.Wave30tq

variable {𝒳 U : Type*} [MeasurableSpace 𝒳] {n m N : ℕ}

/-- The batch structure of the pairs: `lx i`, `ly j` are the batches of `X_i`, `Y_j`; pair `k` lies in batch
`bat k ≥ 1`, the pairs are numbered consecutively over the batches (`bat` monotone), and its blocks `A k`, `B k` are
nonempty, pairwise disjoint on each side, and made of observations of batch `bat k`. -/
def IsBatchPairing (lx : Fin n → ℕ) (ly : Fin m → ℕ) (bat : Fin N → ℕ) (A : Fin N → Finset (Fin n))
    (B : Fin N → Finset (Fin m)) : Prop :=
  IsBlockPairing A B ∧ Monotone bat ∧ (∀ k, 1 ≤ bat k) ∧
    (∀ k, ∀ i ∈ A k, lx i = bat k) ∧ (∀ k, ∀ j ∈ B k, ly j = bat k)

/-- A fitting rule: for each batch `b = bat k` that holds a pair, `g b u x y : 𝒳 → ℝ` (the ramp `g_b`) is jointly
measurable in `(u, x, y)` and the point, takes values in `[0,1]`, and is a function of `u` and of the batches
`0, …, b−1` only. -/
def IsBatchRule [MeasurableSpace U] (lx : Fin n → ℕ) (ly : Fin m → ℕ) (bat : Fin N → ℕ)
    (g : ℕ → U → (Fin n → 𝒳) → (Fin m → 𝒳) → 𝒳 → ℝ) : Prop :=
  ∀ k : Fin N,
    Measurable (fun p : (U × ((Fin n → 𝒳) × (Fin m → 𝒳))) × 𝒳 => g (bat k) p.1.1 p.1.2.1 p.1.2.2 p.2) ∧
    (∀ u x y z, g (bat k) u x y z ∈ Icc (0 : ℝ) 1) ∧
    (∀ u x x' y y', (∀ i, lx i < bat k → x i = x' i) → (∀ j, ly j < bat k → y j = y' j) →
      g (bat k) u x y = g (bat k) u x' y')

/-- Predictable betting fractions at level `α` with cap `c`: `λ_k = lam k u x y (Z_0, …, Z_{k−1})` is jointly
measurable in `(u, x, y)` and the past, takes values in `[0, c/(1+α)]`, and depends on the sample only through the
batches before that of pair `k`. -/
def IsBatchBetRule [MeasurableSpace U] (lx : Fin n → ℕ) (ly : Fin m → ℕ) (bat : Fin N → ℕ) (α c : ℝ)
    (lam : (k : ℕ) → U → (Fin n → 𝒳) → (Fin m → 𝒳) → (Fin k → ℝ) → ℝ) : Prop :=
  ∀ k : Fin N,
    Measurable (fun p : (U × ((Fin n → 𝒳) × (Fin m → 𝒳))) × (Fin k → ℝ) => lam k p.1.1 p.1.2.1 p.1.2.2 p.2) ∧
    (∀ u x y z, 0 ≤ lam k u x y z ∧ lam k u x y z ≤ c / (1 + α)) ∧
    (∀ u x x' y y', (∀ i, lx i < bat k → x i = x' i) → (∀ j, ly j < bat k → y j = y' j) →
      lam k u x y = lam k u x' y')

/-- The pair statistics `Z_k = mean_{i ∈ A_k} g_b(x_i) − mean_{j ∈ B_k} g_b(y_j)`, `b = bat k`. -/
def seqZ (g : ℕ → U → (Fin n → 𝒳) → (Fin m → 𝒳) → 𝒳 → ℝ) (bat : Fin N → ℕ) (A : Fin N → Finset (Fin n))
    (B : Fin N → Finset (Fin m)) (u : U) (x : Fin n → 𝒳) (y : Fin m → 𝒳) (k : Fin N) : ℝ :=
  pairZ (g (bat k) u x y) A B x y k

/-- The sequential certificate rejects `H_{0,α}`: `max_{t ≤ N} K_t ≥ 1/δ`, `K_t = ∏_{k<t}(1 + λ_k(Z_k − α))`. -/
def seqReject (lam : (k : ℕ) → U → (Fin n → 𝒳) → (Fin m → 𝒳) → (Fin k → ℝ) → ℝ)
    (g : ℕ → U → (Fin n → 𝒳) → (Fin m → 𝒳) → 𝒳 → ℝ) (bat : Fin N → ℕ) (A : Fin N → Finset (Fin n))
    (B : Fin N → Finset (Fin m)) (α δ : ℝ) (u : U) (x : Fin n → 𝒳) (y : Fin m → 𝒳) : Prop :=
  betReject (fun k => lam k u x y) α δ (seqZ g bat A B u x y)

/-- Batch 0 and the auxiliary randomness: `(u, (x_i)_{lx i = 0}, (y_j)_{ly j = 0})`. -/
def batchZero (lx : Fin n → ℕ) (ly : Fin m → ℕ) (ω : U × ((Fin n → 𝒳) × (Fin m → 𝒳))) :
    U × (({i : Fin n // lx i = 0} → 𝒳) × ({j : Fin m // ly j = 0} → 𝒳)) :=
  (ω.1, (fun i => ω.2.1 i.1, fun j => ω.2.2 j.1))

/-- The sample `x` with its batch-0 entries replaced by those of `x₀`. -/
def withBatchZero {p : ℕ} (l : Fin p → ℕ) (x₀ x : Fin p → 𝒳) : Fin p → 𝒳 :=
  fun i => if l i = 0 then x₀ i else x i

namespace Claims

/-- `lem:ramp` (iii) (v2 seq): for `s' < s` and measurable `f`, the ramp `g = (f̃ − s')/(s − s')` is measurable with
values in `[0,1]`, and `E_P g − E_Q g ≤ TV(P,Q)`. -/
def lem_ramp_iii : Prop :=
  ∀ (𝒳 : Type) [MeasurableSpace 𝒳] (P Q : Measure 𝒳) [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    (f : 𝒳 → ℝ) (s s' : ℝ), Measurable f → s' < s →
      Measurable (ramp f s s') ∧ (∀ x, ramp f s s' x ∈ Icc (0 : ℝ) 1) ∧
      (∫ x, ramp f s s' x ∂P) - (∫ y, ramp f s s' y ∂Q) ≤ StatFormal.Distances.tvDist P Q

/-- `thm:betting` (v2 seq), conditional on batch 0, for every value of batch 0 (and of `u`): with batch 0 fixed at
`(x₀, y₀)` and the other batches drawn from `P^{⊗n} ⊗ Q^{⊗m}`, `P(max_{t≤N} K_t ≥ 1/δ) ≤ δ`, for every pair with
`TV(P,Q) ≤ α`, every batch pairing, every fitting rule and every choice of fractions. -/
def thm_betting_cond : Prop :=
  ∀ (𝒳 U : Type) [MeasurableSpace 𝒳] [MeasurableSpace U] (P Q : Measure 𝒳) [IsProbabilityMeasure P]
    [IsProbabilityMeasure Q] (n m N : ℕ) (lx : Fin n → ℕ) (ly : Fin m → ℕ) (bat : Fin N → ℕ)
    (A : Fin N → Finset (Fin n)) (B : Fin N → Finset (Fin m)) (α δ c : ℝ)
    (g : ℕ → U → (Fin n → 𝒳) → (Fin m → 𝒳) → 𝒳 → ℝ)
    (lam : (k : ℕ) → U → (Fin n → 𝒳) → (Fin m → 𝒳) → (Fin k → ℝ) → ℝ),
    IsBatchPairing lx ly bat A B → 0 ≤ α → 0 < δ → δ < 1 → 0 < c → c ≤ 1 →
    IsBatchRule lx ly bat g → IsBatchBetRule lx ly bat α c lam →
    StatFormal.Distances.tvDist P Q ≤ α →
      ∀ (u : U) (x₀ : Fin n → 𝒳) (y₀ : Fin m → 𝒳),
        ((Measure.pi fun _ : Fin n => P).prod (Measure.pi fun _ : Fin m => Q))
          {ω | seqReject lam g bat A B α δ u (withBatchZero lx x₀ ω.1) (withBatchZero ly y₀ ω.2)}
            ≤ ENNReal.ofReal δ

/-- `thm:betting` (v2 seq), the printed display: the rejection event is measurable and
`P(max_{t≤N} K_t ≥ 1/δ | batch 0) ≤ δ` almost surely (conditional expectation of its indicator given the σ-algebra
generated by batch 0 and `u`), under `ν ⊗ P^{⊗n} ⊗ Q^{⊗m}`. -/
def thm_betting_condexp : Prop :=
  ∀ (𝒳 U : Type) [MeasurableSpace 𝒳] [MeasurableSpace U] (P Q : Measure 𝒳) [IsProbabilityMeasure P]
    [IsProbabilityMeasure Q] (ν : Measure U) [IsProbabilityMeasure ν]
    (n m N : ℕ) (lx : Fin n → ℕ) (ly : Fin m → ℕ) (bat : Fin N → ℕ)
    (A : Fin N → Finset (Fin n)) (B : Fin N → Finset (Fin m)) (α δ c : ℝ)
    (g : ℕ → U → (Fin n → 𝒳) → (Fin m → 𝒳) → 𝒳 → ℝ)
    (lam : (k : ℕ) → U → (Fin n → 𝒳) → (Fin m → 𝒳) → (Fin k → ℝ) → ℝ),
    IsBatchPairing lx ly bat A B → 0 ≤ α → 0 < δ → δ < 1 → 0 < c → c ≤ 1 →
    IsBatchRule lx ly bat g → IsBatchBetRule lx ly bat α c lam →
    StatFormal.Distances.tvDist P Q ≤ α →
      MeasurableSet {ω : U × ((Fin n → 𝒳) × (Fin m → 𝒳)) | seqReject lam g bat A B α δ ω.1 ω.2.1 ω.2.2} ∧
      condExp (MeasurableSpace.comap (batchZero (𝒳 := 𝒳) (U := U) lx ly) inferInstance)
          (ν.prod ((Measure.pi fun _ : Fin n => P).prod (Measure.pi fun _ : Fin m => Q)))
          (Set.indicator {ω : U × ((Fin n → 𝒳) × (Fin m → 𝒳)) | seqReject lam g bat A B α δ ω.1 ω.2.1 ω.2.2}
            fun _ => (1 : ℝ))
        ≤ᵐ[ν.prod ((Measure.pi fun _ : Fin n => P).prod (Measure.pi fun _ : Fin m => Q))] fun _ => δ

/-- `thm:betting` (v2 seq), "Hence": `P(max_{t≤N} K_t ≥ 1/δ) ≤ δ` for every pair with `TV(P,Q) ≤ α` (level `≤ δ`
for every sample size, uniformly over `H_{0,α}`). -/
def thm_betting : Prop :=
  ∀ (𝒳 U : Type) [MeasurableSpace 𝒳] [MeasurableSpace U] (P Q : Measure 𝒳) [IsProbabilityMeasure P]
    [IsProbabilityMeasure Q] (ν : Measure U) [IsProbabilityMeasure ν]
    (n m N : ℕ) (lx : Fin n → ℕ) (ly : Fin m → ℕ) (bat : Fin N → ℕ)
    (A : Fin N → Finset (Fin n)) (B : Fin N → Finset (Fin m)) (α δ c : ℝ)
    (g : ℕ → U → (Fin n → 𝒳) → (Fin m → 𝒳) → 𝒳 → ℝ)
    (lam : (k : ℕ) → U → (Fin n → 𝒳) → (Fin m → 𝒳) → (Fin k → ℝ) → ℝ),
    IsBatchPairing lx ly bat A B → 0 ≤ α → 0 < δ → δ < 1 → 0 < c → c ≤ 1 →
    IsBatchRule lx ly bat g → IsBatchBetRule lx ly bat α c lam →
    StatFormal.Distances.tvDist P Q ≤ α →
      (ν.prod ((Measure.pi fun _ : Fin n => P).prod (Measure.pi fun _ : Fin m => Q)))
        {ω | seqReject lam g bat A B α δ ω.1 ω.2.1 ω.2.2} ≤ ENNReal.ofReal δ

/-- `cor:lower` (v2 seq), finite-sample clause: a fixed grid `α_1, …, α_J ≥ 0`, each `H_{0,α_j}` tested by the
sequential certificate on the same batches and pairs, with any fitting rule `g^{(j)}` and fractions `λ^{(j)}` at each
level; `α̂_lo` by `eq:downclosed`. Then `P(α̂_lo > TV(P,Q)) ≤ δ` for all sample sizes and every pair `(P,Q)`. -/
def cor_lower : Prop :=
  ∀ (𝒳 U : Type) [MeasurableSpace 𝒳] [MeasurableSpace U] (P Q : Measure 𝒳) [IsProbabilityMeasure P]
    [IsProbabilityMeasure Q] (ν : Measure U) [IsProbabilityMeasure ν]
    (n m N J : ℕ) (lx : Fin n → ℕ) (ly : Fin m → ℕ) (bat : Fin N → ℕ)
    (A : Fin N → Finset (Fin n)) (B : Fin N → Finset (Fin m)) (α : Fin J → ℝ) (δ c : ℝ)
    (g : Fin J → ℕ → U → (Fin n → 𝒳) → (Fin m → 𝒳) → 𝒳 → ℝ)
    (lam : Fin J → (k : ℕ) → U → (Fin n → 𝒳) → (Fin m → 𝒳) → (Fin k → ℝ) → ℝ),
    IsBatchPairing lx ly bat A B → 0 < δ → δ < 1 → 0 < c → c ≤ 1 → (∀ j, 0 ≤ α j) →
    (∀ j, IsBatchRule lx ly bat (g j)) → (∀ j, IsBatchBetRule lx ly bat (α j) c (lam j)) →
      (ν.prod ((Measure.pi fun _ : Fin n => P).prod (Measure.pi fun _ : Fin m => Q)))
        {ω | StatFormal.Distances.tvDist P Q < StatFormal.TrimmedMMD.Lower.alphaLo α
            (fun j => seqReject (lam j) (g j) bat A B (α j) δ ω.1 ω.2.1 ω.2.2)}
          ≤ ENNReal.ofReal δ

/-- "The single split `e = (0, 1/2, 1)` is the case `B = 1`" (one betting batch; `B = 2` under the printed indexing
`e_0 < … < e_B`): the certified single-split Theorem 1 of wave 30tq (fold one fixed, conditional a.s., unconditional)
follows from the sequential version (fold one as `u`, batch 0 empty, every pair in batch 1). -/
def single_split : Prop :=
  (thm_betting_cond → StatFormal.Wave30tq.Claims.thm1_cond) ∧
  (thm_betting_condexp → StatFormal.Wave30tq.Claims.thm1_condexp) ∧
  (thm_betting → StatFormal.Wave30tq.Claims.thm1)

end Claims
end StatFormal.Wave30tv
